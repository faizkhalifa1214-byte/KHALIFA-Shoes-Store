import { useEffect } from "react";
import { Navbar } from "@/components/khalifa/Navbar";
import { Hero } from "@/components/khalifa/Hero";
import { Marquee } from "@/components/khalifa/Marquee";
import { Categories } from "@/components/khalifa/Categories";
import { ProductGrid } from "@/components/khalifa/ProductGrid";
import { Promo } from "@/components/khalifa/Promo";
import { Testimonials } from "@/components/khalifa/Testimonials";
import { FAQ } from "@/components/khalifa/FAQ";
import { Contact } from "@/components/khalifa/Contact";
import { Footer } from "@/components/khalifa/Footer";
import { useReveal } from "@/hooks/useReveal";

const Index = () => {
  useReveal();

  useEffect(() => {
    document.title = "Khalifa Store — Premium Men's & Women's Shoes in Pakistan";
    const setMeta = (name: string, content: string) => {
      let el = document.querySelector(`meta[name="${name}"]`);
      if (!el) {
        el = document.createElement("meta");
        el.setAttribute("name", name);
        document.head.appendChild(el);
      }
      el.setAttribute("content", content);
    };
    setMeta(
      "description",
      "Khalifa Store — hand-finished oxfords, boots, heels and loafers. Premium men's and women's shoes with nationwide delivery across Pakistan."
    );
  }, []);

  return (
    <main className="min-h-screen bg-background">
      <Navbar />
      <Hero />
      <Marquee />
      <Categories />
      <ProductGrid />
      <Promo />
      <Testimonials />
      <section id="faq"><FAQ /></section>
      <Contact />
      <Footer />
    </main>
  );
};

export default Index;

